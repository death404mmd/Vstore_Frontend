generator client {
  provider = "prisma-client-js"
}

// برای سرور واقعی: provider را "postgresql" یا "mysql" کن و DATABASE_URL را عوض کن
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id        Int      @id @default(autoincrement())
  title     String
  summary   String
  tag       String   @default("")
  imageUrl  String?
  link      String?
  sort      Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String
  body      String   @default("")
  type      String   @default("")
  createdAt DateTime @default(now())
}
